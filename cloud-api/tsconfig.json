{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,

    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "target": "ES2020",
    "module": "commonjs",

    "rootDir": "./src",        // ✅ IMPORTANT
    "outDir": "./build/src",

    "esModuleInterop": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "strict": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}